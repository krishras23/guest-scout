{
  "manifest_version": 3,
  "name": "guest-scout",
  "version": "1.1.0",
  "description": "see who's in the room before you show up. pulls socials off luma and partiful guest lists",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://lu.ma/*",
    "https://*.lu.ma/*",
    "https://luma.com/*",
    "https://*.luma.com/*",
    "https://partiful.com/*",
    "https://*.partiful.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lu.ma/*",
        "https://*.lu.ma/*",
        "https://luma.com/*",
        "https://*.luma.com/*",
        "https://partiful.com/*",
        "https://*.partiful.com/*"
      ],
      "js": ["collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://partiful.com/*",
        "https://*.partiful.com/*"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
