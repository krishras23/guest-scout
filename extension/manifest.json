{
  "manifest_version": 3,
  "name": "guest-scout",
  "version": "2.0.0",
  "description": "see who's in the room before you show up. pulls socials off a luma guest list",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://lu.ma/*",
    "https://*.lu.ma/*",
    "https://luma.com/*",
    "https://*.luma.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lu.ma/*",
        "https://*.lu.ma/*",
        "https://luma.com/*",
        "https://*.luma.com/*"
      ],
      "js": ["collector.js"],
      "run_at": "document_idle"
    }
  ]
}
